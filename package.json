{
  "name": "effective-config",
  "displayName": "Effective Config Viewer",
  "description": "Shows the merged .NET appsettings configuration for a chosen environment.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "effectiveConfig.show",
        "title": "Effective Config: Show Merged Configuration",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "effectiveConfig.show",
          "when": "resourceFilename =~ /^appsettings.*\\.json$/i || resourceExtname == .csproj"
        }
      ],
      "editor/title": [
        {
          "command": "effectiveConfig.show",
          "when": "resourceFilename =~ /^appsettings.*\\.json$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "effectiveConfig.show"
        }
      ]
    },
    "configuration": {
      "title": "Effective Config Viewer",
      "properties": {
        "effectiveConfig.dotnet.jsonLayers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "appsettings.json",
            "appsettings.{env}.json",
            "appsettings.secrets.json"
          ],
          "description": "JSON configuration layers, lowest priority first. {env} is replaced by the selected environment."
        },
        "effectiveConfig.maskPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*Password*",
            "*Secret*",
            "*Key*",
            "ConnectionStrings:*"
          ],
          "description": "Case-insensitive glob patterns of keys whose values are masked by default (* matches any characters, including ':')."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "vitest run",
    "test:integration": "vscode-test",
    "lint": "tsc --noEmit",
    "package": "vsce package",
    "pretest:integration": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && npm run build && tsc -p test/integration"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "~1.85.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
